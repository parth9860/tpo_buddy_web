# ==============================================================================
# TPO Buddy - Local Environment Configuration Example
# ==============================================================================
# Copy this file to .env or set environment variables in your system:
# Windows (PowerShell): $env:GEMINI_API_KEY="your-api-key-here"
# Windows (CMD):        set GEMINI_API_KEY=your-api-key-here
# Linux / macOS:        export GEMINI_API_KEY="your-api-key-here"

# Google Gemini API Key (Required for dynamic AI question generation)
# Obtain from: https://aistudio.google.com/ or Google Cloud Console
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model (Defaults to gemini-1.5-flash)
# Supported options: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
GEMINI_MODEL=gemini-1.5-flash

# Server Port
PORT=8085
